<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cancelTinder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ReviewWriting">

    <Button
        android:id="@+id/cancelReviewWriting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF5722"
        android:text="Cancel"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/reviewSubmit"
        app:layout_constraintStart_toStartOf="@+id/reviewComments" />

    <Button
        android:id="@+id/reviewSubmit"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:backgroundTint="#3F51B5"
        app:cornerRadius="0dp"
        android:layout_marginTop="4dp"
        android:text="Submit Review"
        app:layout_constraintEnd_toEndOf="@+id/reviewComments"
        app:layout_constraintTop_toBottomOf="@+id/reviewComments" />

    <AutoCompleteTextView
        android:id="@+id/reviewRestaurant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Restaurant Name"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.112"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.043" />

    <TextView
        android:id="@+id/ambiance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ambiance:"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/overall"
        app:layout_constraintTop_toBottomOf="@+id/overall" />

    <TextView
        android:id="@+id/service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Service:"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/value"
        app:layout_constraintTop_toBottomOf="@+id/value" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Value:"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/food"
        app:layout_constraintTop_toBottomOf="@+id/food" />

    <TextView
        android:id="@+id/overall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Overall:"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/reviewPhoto"
        app:layout_constraintTop_toBottomOf="@+id/reviewPhoto" />

    <TextView
        android:id="@+id/food"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Food &amp; Drink:"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/ambiance"
        app:layout_constraintTop_toBottomOf="@+id/ambiance" />

    <ImageView
        android:id="@+id/reviewPhoto"
        android:layout_width="369dp"
        android:layout_height="222dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reviewRestaurant"
        app:srcCompat="@drawable/ic_launcher_foreground" />

    <RatingBar
        android:id="@+id/reviewOverall"
        style="@style/Widget.AppCompat.RatingBar.Indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:progressTint="#FF5722"
        android:secondaryProgressTint="#FF5722"
        android:isIndicator="false"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.854"
        app:layout_constraintStart_toEndOf="@+id/overall"
        app:layout_constraintTop_toTopOf="@+id/overall" />

    <RatingBar
        android:id="@+id/reviewService"
        style="@style/Widget.AppCompat.RatingBar.Indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:isIndicator="false"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintEnd_toEndOf="@+id/reviewValue"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/reviewValue"
        app:layout_constraintTop_toTopOf="@+id/service" />

    <RatingBar
        android:id="@+id/reviewValue"
        style="@style/Widget.AppCompat.RatingBar.Indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:isIndicator="false"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintEnd_toEndOf="@+id/reviewFood"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/reviewFood"
        app:layout_constraintTop_toTopOf="@+id/value" />

    <RatingBar
        android:id="@+id/reviewAmbiance"
        style="@style/Widget.AppCompat.RatingBar.Indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:isIndicator="false"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintEnd_toEndOf="@+id/reviewOverall"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/reviewOverall"
        app:layout_constraintTop_toTopOf="@+id/ambiance" />

    <RatingBar
        android:id="@+id/reviewFood"
        style="@style/Widget.AppCompat.RatingBar.Indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:isIndicator="false"
        android:scaleX="1"
        android:scaleY="1"
        app:layout_constraintEnd_toEndOf="@+id/reviewAmbiance"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/reviewAmbiance"
        app:layout_constraintTop_toTopOf="@+id/food" />

    <EditText
        android:id="@+id/reviewComments"
        android:layout_width="370dp"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:hint="General Comments"
        android:maxLength="255"
        android:maxLines="5"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.512"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reviewService" />

</androidx.constraintlayout.widget.ConstraintLayout>